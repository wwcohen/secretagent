# Copy this file to ".env" and fill in values for your machine.
# ".env" is gitignored; ".env-sample" is checked in to document the vars.
#
# Loaded automatically by secretagent.config (via python-dotenv) before
# any config is read, so these are visible to OmegaConf interpolations
# such as ${oc.env:PATHTO_REPO}.

# Absolute path to the root of this repository checkout.
# Optional: if unset, the root is auto-detected from .root-sentinel.txt.
# Set it to pin the root explicitly (e.g. when running from outside the repo).
PATHTO_REPO=/absolute/path/to/secretagent

# --- API keys used by litellm / providers (uncomment what you use) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# TOGETHER_API_KEY=